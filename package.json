{
  "name": "@cosyte/astm",
  "version": "0.1.4",
  "description": "ASTM parser, serializer, and builder for Node.js and TypeScript: lenient on parse, spec-clean on emit.",
  "keywords": [
    "astm",
    "astm-e1394",
    "astm-e1381",
    "lis02-a2",
    "lis01-a2",
    "clsi",
    "lis",
    "laboratory",
    "lab-instrument",
    "analyzer",
    "loinc",
    "livd",
    "healthcare",
    "interoperability",
    "parser",
    "serializer",
    "builder",
    "typescript"
  ],
  "homepage": "https://docs.cosyte.com/astm",
  "bugs": {
    "url": "https://github.com/cosyte/astm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/astm.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check": "pnpm run check:gate-coverage && pnpm run check:dependency-inventory",
    "check:dependency-inventory": "tsx scripts/check-dependency-inventory.ts",
    "check:gate-coverage": "tsx scripts/check-gate-coverage.ts",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:documents": "pnpm check:readme && pnpm check:claude-card && pnpm check:catalog",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"docs-content/**/*.{md,json}\" \"examples/**/*.{ts,js,json,md}\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,md}\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"docs-content/**/*.{md,json}\" \"examples/**/*.{ts,js,json,md}\" \"*.{json,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run test/property/frames-fuzz.property.test.ts test/property/records-fuzz.property.test.ts",
    "examples": "tsx scripts/run-examples.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "lint:examples": "eslint examples --max-warnings=0",
    "phi-scan:examples": "tsx scripts/phi-scan.ts examples/*.ts examples/data/*",
    "clean": "rm -rf dist coverage",
    "pack:docs": "bash scripts/build-docs-artifacts.sh",
    "attw": "cosyte-attw",
    "smoke": "node scripts/smoke.mjs",
    "version": "changeset version && node scripts/sync-version.mjs && prettier --write package.json CHANGELOG.md src/index.ts",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw && pnpm check:dependency-inventory",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.1",
    "@cosyte/prettier-config": "^0.1",
    "@cosyte/script-utils": "^0.1.7",
    "@cosyte/test-utils": "^0.1",
    "@cosyte/tsconfig": "^0.1",
    "@cosyte/tsup-config": "^0.1",
    "@cosyte/vitest-config": "^0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.5.0",
    "fast-check": "3.23.2",
    "prettier": "3.8.3",
    "simple-git-hooks": "2.13.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {}
}
